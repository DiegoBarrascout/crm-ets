<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_form_inherit_ets" model="ir.ui.view">
        <field name="name">crm.lead.form.ets</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <notebook>
                    <page string="Datos de Inscripción">
                        <group string="Datos Personales">
                            <field name="x_area"/>
                            <field name="x_vinculo_centro"/>
                            <field name="x_carne"/>
                            <field name="x_curso_otro"/>
                            <field name="x_whatsapp"/>
                            <field name="x_jornada"/>
                            <field name="x_edad_numero"/>
                            <field name="x_edad"/>
                            <field name="x_genero"/>
                            <field name="x_alumno"/>
                            <field name="x_direccion_vivienda"/>
                            <field name="x_departamento"/>
                            <field name="x_municipio"/>
                            <field name="x_como_se_entero"/>
                            <field name="x_ultimo_grado"/>
                        </group>
                        <group string="Datos Laborales">
                            <field name="x_empresa"/>
                            <field name="x_telefono_empresa"/>
                            <field name="x_puesto"/>
                            <field name="x_direccion_empresa"/>
                            <field name="x_empresa_paga"/>
                        </group>
                        <group string="Datos de Facturación">
                            <field name="x_recibo_nombre"/>
                            <field name="x_nit"/>
                            <field name="x_posee_vehiculo"/>
                        </group>
                        <group string="Condiciones">
                            <field name="x_acepta_condiciones"/>
                            <field name="x_formulario_completo"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_kanban_inherit_ets" model="ir.ui.view">
        <field name="name">crm.lead.kanban.ets</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="card">
                    <widget name="web_ribbon" title="lost" bg_color="text-bg-danger" invisible="probability &gt; 0 or active"/>
                    <field class="fw-bold fs-5" name="name"/>
                    <field name="x_kanban_curso" class="text-muted" style="white-space:normal;"/>
                    <field name="x_kanban_detalle" class="text-muted small"/>
                    <field name="email_from" widget="email" class="text-muted text-truncate"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="lead_properties" widget="properties"/>
                    <footer class="pt-1">
                        <div class="d-flex mt-auto align-items-center">
                            <field name="priority" widget="priority" groups="base.group_user" class="me-2"/>
                        </div>
                        <field name="user_id" widget="many2one_avatar_user" domain="[('share', '=', False)]" class="ms-auto"/>
                    </footer>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
