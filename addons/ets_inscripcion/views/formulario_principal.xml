<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="formulario_principal" name="Formulario Principal ETS/TIC">
        <t t-call="website.layout">
            <div class="container mt-4 mb-5">
                <t t-if="area">
                    <form action="/formulario-principal/submit" method="post" id="form-principal">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="area" t-att-value="area"/>
                        <div class="row g-4 align-items-start">
                            <div class="col-lg-5">
                                <div class="card border-0 shadow-sm overflow-hidden mb-4">
                                    <img t-att-src="cat['img']" class="w-100" style="object-fit:cover;max-height:280px;" t-att-alt="cat['titulo']"/>
                                    <div class="card-body">
                                        <h1 class="h4 mb-1 text-primary"><t t-esc="cat['titulo']"/></h1>
                                        <p class="text-muted small mb-0">
                                            <a href="/formulario-principal" class="link-secondary">Cambiar área</a>
                                        </p>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">¿Es egresado o estudiante actual de Fundación Kinal? *</label>
                                    <div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="vinculo_centro" id="vinculo_egresado" value="egresado" required="1"/>
                                            <label class="form-check-label" for="vinculo_egresado">Egresado</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="vinculo_centro" id="vinculo_estudiante" value="estudiante"/>
                                            <label class="form-check-label" for="vinculo_estudiante">Estudiante actual</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="vinculo_centro" id="vinculo_ninguno" value="ninguno"/>
                                            <label class="form-check-label" for="vinculo_ninguno">Ninguno de esos casos</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3 d-none" id="campo_carnet">
                                    <label class="form-label">Número de carné *</label>
                                    <input type="text" name="carne" id="carne_principal" class="form-control" placeholder="Letras y números"/>
                                    <small class="text-muted">Alfanumérico.</small>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <div class="mb-3">
                                    <label class="form-label">Nombre Completo *</label>
                                    <input type="text" name="name" class="form-control" required="1"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Teléfono *</label>
                                    <input type="text" name="phone" id="phone" class="form-control" maxlength="8" required="1"/>
                                    <small class="text-muted">8 dígitos, sin guiones ni espacios.</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Correo electrónico *</label>
                                    <input type="email" name="email_from" class="form-control" required="1"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label"><t t-esc="cat['label_tsu']"/> *</label>
                                    <select name="x_CarreraISTMO" id="tcu_principal" class="form-select" required="1">
                                        <option value="">Seleccione...</option>
                                        <t t-foreach="cat['tcu']" t-as="opt">
                                            <option t-att-value="opt[0]"><t t-esc="opt[1]"/></option>
                                        </t>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label"><t t-esc="cat['label_carrera']"/> *</label>
                                    <select name="x_CarreraTecnica" id="carrera_principal" class="form-select" required="1" disabled="disabled">
                                        <option value="">Seleccione primero el TSU...</option>
                                    </select>
                                    <small id="nota_carrera" class="text-muted d-none"></small>
                                </div>
                                <div class="mb-3 d-none" id="campo_curso_otro">
                                    <label class="form-label">Especifique el curso *</label>
                                    <input type="text" name="curso_otro" id="curso_otro" class="form-control"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label"><t t-esc="cat['label_colaborador']"/> *</label>
                                    <select name="x_trabajadorQueAtendio" class="form-select" required="1">
                                        <option value="">Seleccione...</option>
                                        <t t-foreach="cat['trabajadores']" t-as="opt">
                                            <option t-att-value="opt[0]"><t t-esc="opt[1]"/></option>
                                        </t>
                                    </select>
                                </div>
                                <div class="text-end">
                                    <button type="submit" class="btn btn-lg btn-primary">Enviar</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </t>
            </div>

            <div class="modal fade" id="modal-area" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title">Área de interés</h5>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted">Elige un área para continuar con el formulario.</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <a href="/formulario-principal?area=ets" class="card h-100 shadow-sm text-decoration-none text-dark d-flex flex-column">
                                        <img src="/ets_inscripcion/static/src/img/ets_img.avif" class="card-img-top" alt="ETS" style="height:160px;object-fit:cover;"/>
                                        <div class="card-body d-flex flex-column flex-grow-1">
                                            <h5 class="card-title text-primary">ETS</h5>
                                            <p class="card-text small text-muted">
                                                Escuela Técnica Superior: formación presencial en electricidad,
                                                electrónica industrial, mecánica automotriz, construcción,
                                                soldadura, refrigeración, automatización, topografía y diseño
                                                (AutoCAD y Revit), junto con otros cursos técnicos de planta.
                                            </p>
                                            <span class="btn btn-sm btn-primary mt-auto align-self-end">Continuar</span>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-6">
                                    <a href="/formulario-principal?area=tic" class="card h-100 shadow-sm text-decoration-none text-dark d-flex flex-column">
                                        <img src="/ets_inscripcion/static/src/img/tic_img.avif" class="card-img-top" alt="TIC" style="height:160px;object-fit:cover;"/>
                                        <div class="card-body d-flex flex-column flex-grow-1">
                                            <h5 class="card-title text-primary">TIC</h5>
                                            <p class="card-text small text-muted">
                                                Tecnologías de la información: redes CCNA y CCNP, desarrollo
                                                Fullstack JAVA y .NET, ciberseguridad, nube AWS, bases de datos,
                                                Python, IT Essentials e integración de modelos GPT e IA.
                                            </p>
                                            <span class="btn btn-sm btn-primary mt-auto align-self-end">Continuar</span>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script type="application/json" id="ets-courses-json"><t t-out="courses_json or '{}'"/></script>
            <script type="application/json" id="ets-tcu-disable-json"><t t-out="tcu_disable_json or '[]'"/></script>
            <script type="application/json" id="ets-tcu-notes-json"><t t-out="tcu_notes_json or '{}'"/></script>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var area = <t t-if="area">true</t><t t-else="">false</t>;
                    if (!area) {
                        var el = document.getElementById('modal-area');
                        if (el &amp;&amp; window.bootstrap) {
                            new bootstrap.Modal(el).show();
                        } else if (el) {
                            el.classList.add('show');
                            el.style.display = 'block';
                        }
                    }
                    var phone = document.getElementById('phone');
                    if (phone) {
                        phone.addEventListener('input', function () {
                            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 8);
                        });
                    }

                    function parseJson(id, fallback) {
                        var node = document.getElementById(id);
                        if (!node) return fallback;
                        try { return JSON.parse(node.textContent); } catch (e) { return fallback; }
                    }
                    var coursesByTcu = parseJson('ets-courses-json', {});
                    var tcuDisable = parseJson('ets-tcu-disable-json', []);
                    var tcuNotes = parseJson('ets-tcu-notes-json', {});
                    var tcuSel = document.getElementById('tcu_principal');
                    var carrera = document.getElementById('carrera_principal');
                    var otroWrap = document.getElementById('campo_curso_otro');
                    var nota = document.getElementById('nota_carrera');

                    function fillCarreras(tcu) {
                        if (!carrera) return;
                        carrera.innerHTML = '';
                        var disabled = !tcu || tcuDisable.indexOf(tcu) !== -1;
                        var opts = coursesByTcu[tcu] || [];
                        var first = document.createElement('option');
                        first.value = '';
                        if (disabled) {
                            first.textContent = tcu ? 'No aplica para año académico' : 'Seleccione primero el TSU...';
                            carrera.appendChild(first);
                            carrera.disabled = true;
                            carrera.removeAttribute('required');
                            carrera.value = '';
                        } else {
                            first.textContent = 'Seleccione...';
                            carrera.appendChild(first);
                            opts.forEach(function (pair) {
                                var o = document.createElement('option');
                                o.value = pair[0];
                                o.textContent = pair[1];
                                carrera.appendChild(o);
                            });
                            carrera.disabled = false;
                            carrera.setAttribute('required', 'required');
                        }
                        if (nota) {
                            var msg = tcuNotes[tcu] || '';
                            nota.textContent = msg;
                            nota.classList.toggle('d-none', !msg);
                        }
                        if (otroWrap) otroWrap.classList.add('d-none');
                    }

                    if (tcuSel &amp;&amp; carrera) {
                        tcuSel.addEventListener('change', function () { fillCarreras(this.value); });
                        fillCarreras(tcuSel.value);
                    }
                    if (carrera &amp;&amp; otroWrap) {
                        carrera.addEventListener('change', function () {
                            otroWrap.classList.toggle('d-none', this.value !== 'Otras');
                        });
                    }

                    var carnetWrap = document.getElementById('campo_carnet');
                    var carnetInp = document.getElementById('carne_principal');
                    function toggleCarnet() {
                        var sel = document.querySelector('input[name=vinculo_centro]:checked');
                        var show = sel &amp;&amp; (sel.value === 'egresado' || sel.value === 'estudiante');
                        if (carnetWrap) carnetWrap.classList.toggle('d-none', !show);
                        if (carnetInp) {
                            if (show) carnetInp.setAttribute('required', 'required');
                            else {
                                carnetInp.removeAttribute('required');
                                carnetInp.value = '';
                            }
                        }
                    }
                    document.querySelectorAll('input[name=vinculo_centro]').forEach(function (r) {
                        r.addEventListener('change', toggleCarnet);
                    });
                    if (carnetInp) {
                        carnetInp.addEventListener('input', function () {
                            this.value = this.value.replace(/[^a-zA-Z0-9]/g, '');
                        });
                    }
                    toggleCarnet();
                });
            </script>
        </t>
    </template>
</odoo>
